skinparam activityEndColor #132190
title Publicação e consulta de materiais · UC-10 e UC-11
start
partition "Administrador" {
 :Abrir Materiais e escolher Novo material;
 :Informar título, tema, descrição e situação;
 :Selecionar arquivo;
}
partition "Sistema" {
 if (Dados e arquivo válidos?) then (sim)
  :Gravar anexo e dados do material;
  if (Gravação confirmada?) then (sim)
   if (Situação publicada?) then (sim)
    :Disponibilizar item no catálogo do tema;
   else (arquivada)
    :Manter item somente na curadoria;
    stop
   endif
  else (não)
   :Informar falha e manter formulário;
   stop
  endif
 else (não)
  :Indicar o campo ou arquivo a corrigir;
  stop
 endif
}
partition "Estudante" {
 :Abrir Materiais de estudo e filtrar por tema;
 :Selecionar material publicado;
 if (Origem do material?) then (anexo)
  :Baixar arquivo;
 else (referência externa)
  :Abrir a fonte identificada;
 endif
}
stop
@enduml
