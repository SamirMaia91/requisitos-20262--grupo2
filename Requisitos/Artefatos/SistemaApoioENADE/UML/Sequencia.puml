@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #132190
skinparam titleFontColor #132190
skinparam titleFontSize 23
skinparam shadowing false
skinparam ArrowColor #46658F
skinparam ArrowThickness 1.2
skinparam roundcorner 12
skinparam BorderColor #87A8DE
skinparam actorBorderColor #132190
skinparam actorFontColor #132190
skinparam actorBackgroundColor #E4F2FE
skinparam packageBorderColor #87A8DE
skinparam packageBackgroundColor #F7FAFF
skinparam rectangleBorderColor #87A8DE
skinparam rectangleBackgroundColor #FFFFFF
skinparam usecaseBorderColor #7096D6
skinparam usecaseBackgroundColor #E4F2FE
skinparam classBackgroundColor #F4F8FE
skinparam classBorderColor #7096D6
skinparam componentBackgroundColor #E4F2FE
skinparam componentBorderColor #7096D6
skinparam nodeBackgroundColor #F4F8FE
skinparam nodeBorderColor #7096D6
skinparam databaseBackgroundColor #E4F2FE
skinparam databaseBorderColor #7096D6
skinparam noteBackgroundColor #F7FAFF
skinparam noteBorderColor #87A8DE
skinparam sequenceGroupBorderColor #87A8DE
skinparam sequenceGroupBackgroundColor #E4F2FE
skinparam sequenceLifeLineBorderColor #87A8DE
skinparam sequenceParticipantBorderColor #7096D6
skinparam sequenceParticipantBackgroundColor #E4F2FE
skinparam sequenceMessageAlign center
skinparam activityBackgroundColor #E4F2FE
skinparam activityBorderColor #7096D6
skinparam activityDiamondBackgroundColor #F4F8FE
skinparam activityDiamondBorderColor #7096D6
skinparam activityStartColor #004AF7
skinparam activityEndColor #132190
title Simulado cronometrado e correção · UC-04 e UC-05
hide footbox
actor Estudante as E
boundary "Interface web" as UI
control "Avaliação" as AV
control "Identidade" as ID
control "Catálogo" as CAT
database "Persistência" as DB
E -> UI : define filtros, quantidade e duração
UI -> AV : solicita iniciar
AV -> ID : valida sessão
alt sessão inválida
 AV --> UI : acesso recusado
else sessão válida
 AV -> CAT : busca questões publicadas
 CAT --> AV : questões elegíveis e versões
 alt configuração inválida ou itens insuficientes
  AV --> UI : informa o ajuste necessário
 else configuração válida
  AV -> DB : grava tentativa, fotografia e prazo absoluto
  DB --> AV : tentativa criada
  AV --> UI : apresenta questões sem gabarito
  loop tentativa aberta e antes do prazo
   E -> UI : marca ou altera resposta
   UI -> AV : envia resposta e identifica tentativa
   AV -> DB : grava se pertence ao estudante e continua aberta
  end
  alt encerramento manual confirmado
   E -> UI : confirma encerramento
   UI -> AV : solicita concluir
  else prazo expirado
   AV -> AV : identifica expiração
  end
  AV -> DB : conclui uma única vez e mantém o resultado
  DB --> AV : devolve tentativa concluída
  AV --> UI : resultado e gabarito preservado
  UI --> E : acertos, omissões, comentários e fontes
 end
end
@enduml
