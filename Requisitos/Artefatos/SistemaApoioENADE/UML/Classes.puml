@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #132190
skinparam titleFontColor #132190
skinparam titleFontSize 23
skinparam shadowing false
skinparam ArrowColor #46658F
skinparam ArrowThickness 1.2
skinparam roundcorner 12
skinparam BorderColor #87A8DE
skinparam actorBorderColor #132190
skinparam actorFontColor #132190
skinparam actorBackgroundColor #E4F2FE
skinparam packageBorderColor #87A8DE
skinparam packageBackgroundColor #F7FAFF
skinparam rectangleBorderColor #87A8DE
skinparam rectangleBackgroundColor #FFFFFF
skinparam usecaseBorderColor #7096D6
skinparam usecaseBackgroundColor #E4F2FE
skinparam classBackgroundColor #F4F8FE
skinparam classBorderColor #7096D6
skinparam componentBackgroundColor #E4F2FE
skinparam componentBorderColor #7096D6
skinparam nodeBackgroundColor #F4F8FE
skinparam nodeBorderColor #7096D6
skinparam databaseBackgroundColor #E4F2FE
skinparam databaseBorderColor #7096D6
skinparam noteBackgroundColor #F7FAFF
skinparam noteBorderColor #87A8DE
skinparam sequenceGroupBorderColor #87A8DE
skinparam sequenceGroupBackgroundColor #E4F2FE
skinparam sequenceLifeLineBorderColor #87A8DE
skinparam sequenceParticipantBorderColor #7096D6
skinparam sequenceParticipantBackgroundColor #E4F2FE
skinparam sequenceMessageAlign center
skinparam activityBackgroundColor #E4F2FE
skinparam activityBorderColor #7096D6
skinparam activityDiamondBackgroundColor #F4F8FE
skinparam activityDiamondBorderColor #7096D6
skinparam activityStartColor #004AF7
skinparam activityEndColor #132190
title Modelo de domínio do sistema proposto
hide methods
hide circle
skinparam linetype polyline
class "Usuário" as Usuario {
 id : UUID
 nome : Texto
 email : Texto
 hashSenha : Texto
 salSenha : Texto
 perfil : Estudante ou Administrador
}
class "Questão" as Questao {
 id : UUID
 versão : Inteiro
 ano, curso, componente, tema
 número original, prova, gabarito
 enunciado, comentário
 situação : Rascunho, Publicada ou Arquivada
}
class "Alternativa" as Alt {
 letra : A..E
 texto : Texto
 correta : Booleano
}
class "Tentativa" as Tentativa {
 id : UUID
 tipo : Prática ou Simulado
 início, prazo, término
 estado : Aberta ou Concluída
 motivo : Manual ou Prazo
}
class "Item da tentativa" as Item {
 ordem : Inteiro
 fotografia da questão
 fotografia do gabarito
}
class "Resposta" as Resposta {
 letra selecionada : A..E
}
class "Material de Estudo" as Material #E4F2FE {
 id : UUID
 título : Texto
 tema : Texto
 descrição : Texto
 situação : Publicado ou Arquivado
 arquivadoEm : DataHora [0..1]
 urlOrigem : HTTPS [0..1]
}
class "Anexo" as Anexo {
 id : UUID
 nome : Texto
 tipo : MIME
 tamanho : Bytes
}
class "Mensagem" as Msg {
 id : UUID
 texto : Texto
 data : DataHora
 situação : Visível ou Oculta
}
class "Denúncia" as Den {
 id : UUID
 motivo : Texto
 estado : Aguardando análise ou Analisada
 decisão, justificativa, data da decisão
}
Usuario "1" -- "0..*" Tentativa : realiza
Usuario "1" -- "0..*" Msg : publica
Usuario "1" -- "0..*" Den : registra
Usuario "0..1" -- "0..*" Den : decide {administrador}
Usuario "0..1" -- "0..*" Material : mantém {administrador}
Material "1" *-- "0..1" Anexo : arquivo
Questao "1" *-- "5" Alt : alternativas
Questao "1" -- "0..*" Msg : discussão
Msg "1" -- "0..*" Den : sinalizações
Tentativa "1" *-- "1..*" Item : itens
Item "0..*" --> "1" Questao : referência
Item "1" *-- "0..1" Resposta : seleção
note bottom of Material
Uma origem por material:
anexo ou referência HTTPS.
end note
note bottom of Item
A fotografia preserva a versão
respondida em tentativas anteriores.
end note
@enduml
