skinparam activityEndColor #132190
title Simulado cronometrado · UC-04 e UC-05
start
partition "Preparar" {
 :Definir filtros, quantidade e duração;
 if (Configuração válida e itens suficientes?) then (sim)
  :Criar tentativa e preservar a versão das questões;
  :Fixar prazo absoluto;
 else (não)
  :Informar ajuste necessário;
  stop
 endif
}
partition "Responder e encerrar" {
 while (Tentativa aberta?) is (sim)
  if (Prazo atingido?) then (sim)
   :Encerrar por prazo;
  else (não)
   :Apresentar questão e tempo;
   :Registrar seleção quando houver resposta;
   if (Confirma encerramento manual?) then (sim)
    :Encerrar manualmente;
   else (não)
    :Manter a tentativa aberta;
   endif
  endif
 endwhile (não)
}
partition "Consultar resultado" {
 :Persistir encerramento único;
 :Calcular acertos, erros e omissões;
 :Liberar correção comentada e atualizar histórico;
}
stop
@enduml
